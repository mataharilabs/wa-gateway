# Kunci Bearer yang WAJIB dikirim SSO di header Authorization.
# Generate: openssl rand -base64 32  (atau PowerShell RandomNumberGenerator)
GATEWAY_API_KEY=""

# Port HTTP (Railway mengisi otomatis; default 8080)
PORT=8080

# Lokasi simpan sesi WhatsApp. Di Railway arahkan ke volume, mis. /data/auth
DATA_DIR=./data/auth

# Level log pino: warn (default) / info / debug
LOG_LEVEL=warn
